{
	"name": "worker-ai-chatbot",
	"main": "src/worker.js",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2025-11-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "api.chienliu.com/chatbot",
			"zone_name": "chienliu.com"
		}
	],
	"vars": {
		"ALLOWED_ORIGIN": "https://chienliu.com"
	},
	"ratelimits": [
		{
			"name": "CHATBOT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vectorize": [
		{
			"binding": "VECTORIZE_INDEX",
			"index_name": "chien-ai-chatbot-rag",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chien-ai-chatbot-rag",
			"database_id": "5320d07d-2352-4824-b0f9-801880fd9b71",
			"remote": true
		}
	],
    "workflows": [
    {
      "name": "chien-ai-chatbot-rag",
      "binding": "RAG_WORKFLOW",
      "class_name": "RAGWorkflow"
    }
  ]
}
